{% assign work_experience = site.data.work_experience %}

{% if work_experience %}
  <div class="publications work-experience">
    <ol class="bibliography">
      {% for item in work_experience %}
        {% assign entry_class = 'work-experience-entry' %}
        {% if item.logo %}
          {% assign entry_class = entry_class | append: ' work-experience-entry-with-logo' %}
        {% endif %}
        {% assign company_link_external = false %}
        {% if item.company_url %}
          {% if item.company_url contains '://' %}
            {% assign company_link_external = true %}
          {% endif %}
        {% endif %}

        <li>
          <div class="{{ entry_class }}">
            {% if item.logo %}
              <div class="work-experience-logo-column">
                <img
                  class="work-experience-logo"
                  src="{{ item.logo | relative_url }}"
                  alt="{{ item.company | append: ' logo' | escape }}"
                  width="200"
                  height="200"
                  loading="lazy"
                >
              </div>
            {% endif %}
            <div id="{{ item.company | append: '-' | append: item.role | slugify }}" class="work-experience-content">
              <div class="title">
                {{ item.role }} @
                {% if item.company_url %}
                  <a href="{{ item.company_url }}" {% if company_link_external %}target="_blank" rel="external nofollow noopener"{% endif %}>{{ item.company }}</a>
                {% else %}
                  {{ item.company }}
                {% endif %}
                {% if item.period %}
                  <span class="work-experience-period">({{ item.period }})</span>
                {% endif %}
              </div>
              {% if item.description %}
                <div class="periodical">
                  {{ item.description | markdownify | remove: '<p>' | remove: '</p>' | strip }}
                </div>
              {% endif %}
            </div>
          </div>
        </li>
      {% endfor %}
    </ol>
  </div>
{% endif %}
