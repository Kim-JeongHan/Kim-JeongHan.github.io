{% assign post = include.post %}
{% assign post_summary = post.description | default: post.excerpt | strip_html | strip_newlines | strip | truncate: 180 %}
{% assign year = post.date | date: "%Y" %}
{% assign tags = post.tags | join: "" %}
{% assign categories = post.categories | join: "" %}
{% assign is_external_redirect = false %}

{% if post.redirect %}
  {% if post.redirect contains '://' %}
    {% assign is_external_redirect = true %}
  {% endif %}
{% endif %}

{% if post.external_source == blank %}
  {% assign read_time = post.content | number_of_words | divided_by: 180 | plus: 1 %}
{% else %}
  {% assign read_time = post.feed_content | strip_html | number_of_words | divided_by: 180 | plus: 1 %}
{% endif %}

{% capture post_url %}
  {% if post.redirect == blank %}
    {{ post.url | relative_url }}
  {% elsif is_external_redirect %}
    {{ post.redirect }}
  {% else %}
    {{ post.redirect | relative_url }}
  {% endif %}
{% endcapture %}
{% assign post_url = post_url | strip %}

<article
  class="blog-post-card{% if include.featured %} blog-post-card-featured{% endif %}{% if include.compact %} blog-post-card-compact{% endif %}{% if include.extra_class %} {{ include.extra_class }}{% endif %}"
  {% if include.archive_item %}data-archive-item{% endif %}
  {% if include.archive_hidden %}hidden{% endif %}
>
  <div class="blog-post-card-main">
    <div class="blog-post-card-header">
      {% if include.featured %}
        <span class="blog-post-kicker"><i class="fa-solid fa-thumbtack fa-xs"></i> 추천</span>
      {% endif %}
      <h3 class="blog-post-title">
        {% if is_external_redirect %}
          <a href="{{ post_url }}" target="_blank" rel="noopener noreferrer">{{ post.title }}</a>
        {% else %}
          <a href="{{ post_url }}">{{ post.title }}</a>
        {% endif %}
      </h3>
    </div>

    {% unless include.compact %}
      {% if post_summary != "" %}
        <p class="blog-post-summary">{{ post_summary }}</p>
      {% endif %}
    {% endunless %}

    <div class="blog-post-meta">
      <span><i class="fa-solid fa-clock fa-sm"></i> {{ read_time }}분 읽기</span>
      <span>
        <i class="fa-solid fa-calendar fa-sm"></i>
        <time datetime="{{ post.date | date_to_xmlschema }}">{{ post.date | date: '%Y.%m.%d' }}</time>
      </span>
      {% if post.external_source %}
        <span>{{ post.external_source }}</span>
      {% endif %}
    </div>

    <div class="blog-post-taxonomy">
      <a href="{{ year | prepend: '/blog/' | relative_url }}">
        <i class="fa-solid fa-calendar fa-sm"></i> {{ year }}
      </a>

      {% if categories != "" %}
        {% for category in post.categories %}
          <a href="{{ category | slugify | prepend: '/blog/category/' | relative_url }}">
            <i class="fa-solid fa-tag fa-sm"></i> {{ category }}
          </a>
        {% endfor %}
      {% endif %}

      {% if tags != "" %}
        {% for tag in post.tags limit: 4 %}
          <a href="{{ tag | slugify | prepend: '/blog/tag/' | relative_url }}">
            <i class="fa-solid fa-hashtag fa-sm"></i> {{ tag }}
          </a>
        {% endfor %}
      {% endif %}
    </div>
  </div>

  {% if post.thumbnail %}
    <a
      class="blog-post-thumb"
      href="{{ post_url }}"
      aria-label="{{ post.title }}"
      {% if is_external_redirect %}target="_blank" rel="noopener noreferrer"{% endif %}
    >
      <img src="{{ post.thumbnail | relative_url }}" alt="" loading="lazy">
    </a>
  {% endif %}
</article>
