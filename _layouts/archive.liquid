---
layout: default
---
<div class="post">
  {% assign archive_active_category = "" %}
  {% if page.type == 'categories' %}
    {% assign archive_active_category = page.title %}
  {% endif %}
  {% assign archive_page_size = 10 %}

  <div class="blog-index-mobile-nav">
    <details class="blog-category-details">
      <summary class="blog-category-summary">
        <span>카테고리</span>
        <i class="fa-solid fa-chevron-down fa-sm"></i>
      </summary>
      {% include blog_category_browser.liquid active_category=archive_active_category %}
    </details>
  </div>

  <div class="blog-index-layout">
    <div class="blog-index-feed">
      <header class="post-header">
        {% if page.type == 'categories' %}
          <h1 class="post-title"><i class="fa-solid fa-tag fa-sm"></i> {{ page.title }}</h1>
          <p class="post-description">{{ page.title }} 카테고리의 글</p>
        {% elsif page.type == 'year' %}
          <h1 class="post-title"><i class="fa-solid fa-calendar fa-sm"></i> {{ page.date | date: '%Y' }}</h1>
          <p class="post-description">{{ page.date | date: '%Y' }}년에 작성한 글</p>
        {% elsif page.type == 'tags' %}
          <h1 class="post-title"><i class="fa-solid fa-hashtag fa-sm"></i> {{ page.title }}</h1>
          <p class="post-description">{{ page.title }} 태그가 달린 글</p>
        {% endif %}
      </header>

      <article class="archive blog-index-section">
        <div class="blog-post-list archive-post-list" data-archive-list data-archive-page-size="{{ archive_page_size }}">
          {% for document in page.documents %}
            {% assign archive_hidden = false %}
            {% if forloop.index > archive_page_size %}
              {% assign archive_hidden = true %}
            {% endif %}
            {% include blog_post_card.liquid post=document compact=true archive_item=true archive_hidden=archive_hidden %}
          {% endfor %}
        </div>

        {% if page.documents.size > archive_page_size %}
          <nav class="archive-pagination af-pagination" aria-label="Archive page navigation" data-archive-pagination>
            <button class="af-page-link archive-page-button" type="button" data-archive-prev aria-label="Previous archive page">&lt;</button>
            <span class="archive-page-list" data-archive-pages></span>
            <button class="af-page-link archive-page-button" type="button" data-archive-next aria-label="Next archive page">&gt;</button>
          </nav>
        {% endif %}
      </article>
    </div>

    <aside class="blog-index-sidebar">
      {% include blog_category_browser.liquid active_category=archive_active_category %}
    </aside>
  </div>
</div>

<script defer src="{{ '/assets/js/archive-pagination.js' | relative_url | bust_file_cache }}" type="text/javascript"></script>
